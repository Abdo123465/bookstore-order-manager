{
  "name": "bookstore-order-manager",
  "private": true,
  "version": "2.4.0",
  "description": "Bookstore Order Management System",
  "author": "Bookstore",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "rebuild": "electron-builder install-app-deps",
    "build:dir": "npm run build && npx electron-builder --win dir",
    "migrate-data": "node scripts/migrate-to-supabase.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.bookstore.ordermanager",
    "artifactName": "Bookstore-Order-Manager-Setup-${version}.${ext}",
    "productName": "Bookstore Order Manager",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "index.css"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "Abdo123465",
      "repo": "bookstore-order-manager"
    },
    "portable": {
      "artifactName": "${productName} Portable.${ext}",
      "unicode": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.37.0",
    "@supabase/supabase-js": "^2.95.3",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2",
    "lucide-react": "^0.562.0",
    "pg": "^8.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  }
}
